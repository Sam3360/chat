rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chat-images/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
